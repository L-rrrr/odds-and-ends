---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const siteName = 'some notes';
const { title, description = "things I've been learning." } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title ? `${title} · ${siteName}` : siteName}</title>
  <meta name="description" content={description}>
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300&family=IBM+Plex+Mono:wght@400&display=swap" rel="stylesheet">
</head>
<body>
  <main>
    <slot />
    <footer class="mono">
      <p>no credit needed. no citations either.</p>
      <p>written by a human, slowly.</p>
    </footer>
  </main>
</body>
</html>
